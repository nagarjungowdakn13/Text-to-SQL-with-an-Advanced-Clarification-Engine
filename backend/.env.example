# ==========================================
# QueryPilot Environment Configuration
# ==========================================

# Core Application Settings
ENV=development
DEBUG=true
PROJECT_NAME=QueryPilot
SECRET_KEY=supersecretkeychangeinproductionjwtgeneration
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# FastAPI Server Host and Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Cache Settings
# If Redis is not available, the app falls back to in-memory caching and rate limiting
REDIS_URL=redis://localhost:6379/0

# Database Configuration - Application Metadata (History, Audit, Semantics)
# Uses PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/querypilot_app

# Database Configuration - Target Query Execution Database (Read-Write for Seeding/Setup)
EXECUTION_DB_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/querypilot_execution

# Database Configuration - Target Query Execution Database (Low-Privilege Read-Only for LLM SQL)
# In production, this user MUST only have SELECT privileges and no DDL/DML write access
EXECUTION_DB_READONLY_URL=postgresql://querypilot_ro:readonlypassword@localhost:5432/querypilot_execution

# LLM Providers Configuration
# Set the keys for the providers you want to use.
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default LLM Provider Settings
# Options: gemini, openai, anthropic, mock
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-model

# Clarification Engine Defaults
# Threshold above which ambiguity requires clarification (0.0 to 1.0)
AMBIGUITY_THRESHOLD=0.7
MAX_CLARIFICATION_ROUNDS=2
MAX_REPAIR_ATTEMPTS=3

# Safe Query Limits
QUERY_TIMEOUT_SECONDS=5
MAX_EXECUTION_ROWS=500
